---
import Base from "../layouts/Base.astro";
import SectionHeader from "../components/SectionHeader.astro";
import ServiceCard from "../components/ServiceCard.astro";
import ReasonCard from "../components/ReasonCard.astro";
import ServiceCompareTable from "../components/ServiceCompareTable.astro";
import VoiceCard from "../components/VoiceCard.astro";
import PriceTable from "../components/PriceTable.astro";
import PricePlan from "../components/PricePlan.astro";
import QaItem from "../components/QaItem.astro";
import CtaButton from "../components/CtaButton.astro";
import { LINE_URL } from "../consts";

const base = import.meta.env.BASE_URL;

// §2 信頼帯：合格校（写真があるものはWikipediaから、無いものは色面プレースホルダ）
const passSchools = [
  { name: "大阪国際", group: "中学受験", img: "osaka-kokusai.webp" },
  { name: "常翔啓光学園", group: "中学受験", img: "keiko.webp" },
  { name: "寝屋川", group: "高校受験", img: "neyagawa.webp" },
  { name: "東", group: "高校受験", img: "higashi.webp" },
  { name: "牧野", group: "高校受験", img: "makino.webp" },
  { name: "いちりつ", group: "高校受験", img: "ichiritsu.webp" },
  { name: "枚方", group: "高校受験", img: "hirakata.webp" },
  { name: "香里丘", group: "高校受験", img: "korigaoka.webp" },
  { name: "北かわち皐が丘", group: "高校受験", img: "kitakawachi.webp" },
  { name: "大阪国際", group: "高校受験", img: "osaka-kokusai.webp" },
  { name: "常翔啓光学園", group: "高校受験", img: "keiko.webp" },
  { name: "東海大学付属大阪仰星", group: "高校受験", img: "gyosei.webp" },
  { name: "香里ヌヴェール学院", group: "高校受験", img: "kori-nuvelle.webp" },
  { name: "四條畷学園", group: "高校受験", img: "shijonawate-gakuen.webp" },
];

// ファーストビュー直下のクイックナビ（縦長カラムカード）
const services = [
  {
    index: "01",
    title: "義塾",
    shortLabel: "成田町の校舎で学ぶ",
    anchorId: "service-real",
    accentColor: "#4C1D95",
    bgImage: `${base}images/optimized/hero-real.webp`,
    bgWidth: 1200,
    bgHeight: 1600,
    // 机・椅子の主役群を見せる
    bgPosition: "70% center",
  },
  {
    index: "02",
    title: "義塾の家庭教師",
    shortLabel: "講師がご自宅へ訪問",
    anchorId: "service-tutor",
    accentColor: "#2563B8",
    bgImage: `${base}images/optimized/hero-tutor.webp`,
    bgWidth: 1400,
    bgHeight: 788,
    // 生徒（中央寄り）と講師（右）の2人セットを縦長窓に収める
    bgPosition: "75% center",
  },
  {
    index: "03",
    title: "アクセス",
    shortLabel: "お問い合わせ・所在地",
    anchorId: "access",
    accentColor: "#1F6B45",
    bgImage: `${base}images/optimized/building-sign.webp`,
    bgWidth: 960,
    bgHeight: 1280,
    // 義塾の看板とインターホンがカード中央に収まる位置
    bgPosition: "center center",
  },
];

// 2つの学び方の比較表用（§5.6 スキャナブル）
const servicesCompare = [
  {
    name: "校舎",
    target: "小3〜高3",
    form: "個別／クラス",
    price: "11,000円～35,200円",
    forWhom: "通塾可能・集団で切磋琢磨",
    accent: "#4C1D95",
  },
  {
    name: "家庭教師",
    target: "小3〜高3",
    form: "訪問1対1",
    price: "28,600円",
    forWhom: "進路相談込みのマンツー",
    accent: "#2563B8",
  },
];

// 共感ブロック Before：6項目チェックリスト（悩み）
const empathyItems = [
  "お子様のテストの点数が伸び悩んでいる",
  "受験までに間に合うか不安",
  "子どもに合う指導形態（個別／クラス／家庭教師）が分からない",
  "通塾の送迎が大変",
  "自宅学習だと集中できない",
  "進路や勉強法を相談できる相手が欲しい",
];

// 共感ブロック After：6項目の解決約束（Beforeと同じ並び順）
const solveItems = [
  "学び方から見直し、点数の伸びる指導を設計します",
  "入塾面談で、受験までのカリキュラムを一緒に設計します",
  "校舎／家庭教師の2つから最適な形をご提案します",
  "ご自宅で受けられる家庭教師も選べます",
  "集中できる校舎環境と週次の伴走で学習を習慣化します",
  "塾長と公式LINEで直接ご相談いただけます",
];

// §4 選ばれる3つの理由
const reasons = [
  {
    number: "01",
    title: "「塾長の私が、最後まで責任を持ってお返事します。」",
    bullets: [
      "大手チェーン塾では難しい、塾長と保護者の直接コミュニケーション",
      "進路相談・成績不振の相談・通塾相談まで、公式LINEから直接連絡可能",
      "担当が変わっても、塾長は変わらず伴走する",
    ],
    iconSrc: `${base}images/optimized/reason-icon-line.webp`,
    iconAlt: "公式LINEで塾長と直接つながる",
  },
  {
    number: "02",
    title: "「お子様の状況に、塾を合わせる。」",
    bullets: [
      "校舎・家庭教師訪問の2サービスを併走",
      "部活・習い事・送迎事情・性格・志望校に合わせて最適な学び方を提案",
      "入塾後も状況変化に応じて指導形態を柔軟に変更可能",
    ],
    iconSrc: `${base}images/optimized/reason-icon-fork.webp`,
    iconAlt: "2つの学び方から選べる柔軟性",
  },
  {
    number: "03",
    title: "「ベテランから若手まで、得意領域を持つ9人体制。」",
    bullets: [
      "中学受験・高校受験・大学受験すべてに対応できる講師布陣",
      "プレゼン講座など、得意領域を持つ講師が在籍",
      "1人の講師に依存しないチーム指導で、苦手単元を講師同士でカバー",
    ],
    iconSrc: `${base}images/optimized/reason-icon-team.webp`,
    iconAlt: "9名の講師チーム",
  },
];

// §6 保護者の声（実データ・クライアント提供アンケートより）
const parentVoices = [
  {
    name: "中高生の姉妹のお母様",
    role: "中高生姉妹／受験対応",
    quote: "中高生の姉妹でお世話になっております。<br />先生方は皆様優しく、アットホームな雰囲気の中で楽しく学べているようです。<br />自習室も積極的に利用させていただいており、誘惑の多い自宅よりも集中して取り組める環境に感謝しています。<br />受験期には的確なデータ分析で娘を合格へと導いてくださり、勉強からメンタルまで幅広く支えていただきました。非常に信頼できる塾として、これからも通い続けたいと思います。",
    avatarSrc: `${base}images/optimized/voice-avatar-mother-1.webp`,
  },
  {
    name: "中学生のお母様",
    role: "中学生／個別指導",
    quote: "先生方がとても親身になって色んな話を聞いて下さるので、とても居心地が良く、通いやすく、以前よりも前向きに勉強に向き合えるようになっています。<br />勉強だけでなく、プレゼンなどにも力を入れておられるので、色んな事を学べるのも魅力のひとつです。<br />テストに向けて色んな対策をして下さるので、親としてもとても安心です。",
    avatarSrc: `${base}images/optimized/voice-avatar-mother-2.webp`,
  },
  {
    name: "高校生のお母様",
    role: "高校生／クラス授業",
    quote: "開校当初よりお世話になり現在高1です。受験の折には本人、保護者の意思を尊重してくださり、また勉強面のみではなく精神的なサポートもしていただき不安なく受験当日を迎えることができました。<br />塾にはベテランの先生だけでなく大学生の先生もいて、子供にとってはお兄ちゃんお姉ちゃんみたいで接しやすく質問もしやすい環境だと思います。<br />また学習面以外でもイベントなどを企画してくださり、普段からのコミュニケーションを大切にしてくださっています。",
    avatarSrc: `${base}images/optimized/voice-avatar-mother-3.webp`,
  },
];

// FAQ（§9）
const faqs = [
  {
    q: "初月授業料1ヶ月無料の対象や条件を教えてください。",
    a: '新規入塾生限定のキャンペーンです。対象期間・対象サービス・対象学年・適用条件の詳細は、公式LINEからお問い合わせください。<!-- 要確認: キャンペーン詳細条件 -->',
  },
  {
    q: "公式LINEに登録したら、しつこく勧誘されませんか？",
    a: "ご安心ください。義塾の公式LINEは、塾長との相談窓口としてご利用いただくものです。ご家庭の状況をうかがった上でご案内するため、無理な勧誘や強引な営業は一切いたしません。ご相談だけで終わっていただいて構いません。<!-- 要確認: 勧誘ポリシーの最終文言 -->",
  },
  {
    q: "無料体験はできますか？",
    a: "はい、公式LINE登録後、塾長との個別相談を経て無料体験授業をご案内します（校舎・家庭教師に対応）。",
  },
  {
    q: "途中で退塾する場合の手続きは？",
    a: "月末締めでのご退塾手続きが基本です。違約金等は発生しません。<!-- 要確認: 退塾手続きの正確なルール -->",
  },
  {
    q: "部活や習い事と両立できますか？",
    a: "はい、通塾は17:00〜21:40の中から時間帯を選択でき、家庭教師は曜日・時間をご家庭の都合に合わせて調整します。家庭教師なら移動時間を抑えて両立しやすくなります。",
  },
  {
    q: "途中で指導形態（校舎↔家庭教師）を変更できますか？",
    a: "状況に応じて柔軟にご相談いただけます。塾長との個別面談で最適な形をご提案します。<!-- 要確認: 形態変更時の事務手続き -->",
  },
  {
    q: "受験対策はどの学年から始めればよいですか？",
    a: "中学受験は小3〜小5、高校受験は中1〜中2、大学受験は高1からのスタートが理想です。学年や状況に応じて、塾長が最適なプランをご提案します。",
  },
];
---

<Base>
  {/* ============ §1 ファーストビュー ============ */}
  <section class="hero">
    {/* 上部全幅の紫帯：ロゴ＋住所サブ */}
    <div class="hero__topband">
      <div class="hero__topband-inner">
        <span class="hero__topband-logo">
          <ruby>義塾<rt>よしじゅく</rt></ruby>
        </span>
        <span class="hero__topband-sub">
          中学受験・高校受験・大学受験対応<br />小3～高3、ご通塾または家庭教師
        </span>
      </div>
    </div>

    {/* FV画像エリア（実写：義塾校舎外観＋キャッチコピーオーバーレイ） */}
    <div class="hero__photo">
      <img src={`${base}images/optimized/building-exterior.webp`} alt="義塾の校舎外観（成田町）" width="1440" height="1920" loading="eager" fetchpriority="high" decoding="async" />
      <span class="hero__photo-tint" aria-hidden="true"></span>

      {/* §1 写真上オーバーレイ：成田町の学習塾（赤枠位置・建物上部左／シャドーで可読性確保） */}
      <p class="hero__photo-place">成田町の学習塾</p>

      {/* タイトル：義塾ロゴ（毛筆書道・透過PNG） */}
      <h1 class="hero__catch">
        <img src={`${base}images/optimized/logo-yoshijuku.webp`} alt="義塾（よしじゅく）" class="hero__logo" width="960" height="720" loading="eager" fetchpriority="high" decoding="async" />
      </h1>

      {/* §1 円形メダル型ゴールドバッジ（写真下端寄り・白パネルにまたぐ） */}
      <div class="hero__medal" aria-label="新規入塾生限定 初月授業料1ヶ月無料">
        <img src={`${base}images/optimized/badge-medal.webp`} alt="新規入塾生限定 初月授業料1ヶ月無料" width="640" height="640" loading="eager" decoding="async" />
      </div>
    </div>

    {/* 下段：義塾の想い＋9人講師シルエット（画像として独立表示・素材を活かす） */}
    <div class="hero__panel">
      <div class="hero__story">
        <h2 class="hero__story-title">学生時代の思い出の場所</h2>
        <div class="hero__story-copy">
          <p>
            真剣に学び、思いきり笑える。<br />
            そんなアットホームな環境の中で<br />
            お子様一人ひとりの学力を引き上げます。
          </p>
          <p>いつか子どもたちが振り返ったとき</p>
          <div class="hero__story-quotes">
            <p>「あの時、よく勉強がんばったな」</p>
            <p>「ここで過ごせてよかったな」</p>
          </div>
          <p>そう思ってもらえる塾でありたい。</p>
          <p>
            義塾はそんな「思い出の場所」を目指して<br />
            今日も子どもたちと向き合っています。
          </p>
        </div>
      </div>
      <div class="hero__teachers" aria-label="9人の講師陣のシルエット">
        <img src={`${base}images/optimized/teachers-silhouette-9.webp`} alt="" width="1600" height="500" loading="eager" decoding="async" />
      </div>
    </div>

    {/* クイックナビ：横幅いっぱい・gap無し */}
    <div class="hero__nav" id="service-nav">
      {services.map((s) => <ServiceCard {...s} />)}
    </div>

  </section>

  {/* CTA ① FV直下（FV紫専用） */}
  <CtaButton text="無料体験授業を申し込む" href={LINE_URL} id="cta-1" variant="fv" />

  {/* ============ §2 共感＋解決＋合格実績 ============ */}
  <section class="section section--purple-pale empathy">
    <div class="container">
      <SectionHeader
        title="成績・進路で、こんなお悩みありませんか？"
        lead="一つでも当てはまるなら、<span class='mark'>一人で抱え込まずに義塾にご相談ください。</span>"
      />

      {/* ① Before：悩みリスト＋左にシルエット（リストに追従） */}
      <div class="empathy__pair empathy__pair--problems">
        <img class="empathy__silhouette empathy__silhouette--problems" src={`${base}images/optimized/empathy-silhouette-question.webp`} alt="" width="640" height="800" loading="lazy" decoding="async" aria-hidden="true" />
        <ul class="empathy__list empathy__list--problems">
          {empathyItems.map((item) => (
            <li>
              <span class="empathy__mark empathy__mark--q" aria-hidden="true">?</span>
              <span>{item}</span>
            </li>
          ))}
        </ul>
      </div>

      {/* ② 橋渡しコピー */}
      <p class="empathy__bridge">
        上記に一つでも当てはまるなら、<br />
        <span>義塾はこれで解決します！</span>
      </p>

      {/* ③ After：解決リスト＋右にシルエット（具体的な解決約束 6項目） */}
      <div class="empathy__pair empathy__pair--solve">
        <ul class="empathy__list empathy__list--solve">
          {solveItems.map((item) => (
            <li>
              <span class="empathy__check" aria-hidden="true">
                <svg viewBox="0 0 28 28" fill="none" width="28" height="28">
                  <path d="M5 14l6 6 13-13" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>
              <span>{item}</span>
            </li>
          ))}
        </ul>
        <img class="empathy__silhouette empathy__silhouette--solve" src={`${base}images/optimized/empathy-silhouette-solved.webp`} alt="" width="640" height="800" loading="lazy" decoding="async" aria-hidden="true" />
      </div>
    </div>

    {/* ④ ZERO型 ▼ 視線誘導ブロック＋証拠への橋渡し */}
    <div class="empathy__transition">
      <p class="empathy__transition-text">
        <span>合格実績</span>
      </p>
    </div>

    {/* ⑤ 合格実績カード（証拠）：中学受験・高校受験を2行に分けて表示（こくふFB対応） */}
    <div class="trust__rail trust__rail--inempathy">
      <div class="trust__row">
        <p class="trust__row-label">中学受験 合格校</p>
        <p class="scroll-hint">横にスクロールして合格校を見る</p>
        <ul class="trust__cards" aria-label="中学受験 合格校一覧" tabindex="0">
          {passSchools.filter((s) => s.group === "中学受験").map((s) => (
            <li
              class={`trust__card ${s.img ? "" : "trust__card--placeholder"}`}
              style={s.img ? `background-image: url(${base}images/optimized/schools/${s.img});` : ""}
            >
              <span class="trust__card-overlay" aria-hidden="true"></span>
              <div class="trust__card-content">
                <span class="trust__card-group">{s.group}</span>
                <span class="trust__card-name">{s.name}</span>
              </div>
            </li>
          ))}
        </ul>
      </div>
      <div class="trust__row">
        <p class="trust__row-label">高校受験 合格校</p>
        <p class="scroll-hint">横にスクロールして合格校を見る</p>
        <ul class="trust__cards" aria-label="高校受験 合格校一覧" tabindex="0">
          {passSchools.filter((s) => s.group === "高校受験").map((s) => (
            <li
              class={`trust__card ${s.img ? "" : "trust__card--placeholder"}`}
              style={s.img ? `background-image: url(${base}images/optimized/schools/${s.img});` : ""}
            >
              <span class="trust__card-overlay" aria-hidden="true"></span>
              <div class="trust__card-content">
                <span class="trust__card-group">{s.group}</span>
                <span class="trust__card-name">{s.name}</span>
              </div>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  {/* CTA ② 共感末尾 */}
  <CtaButton text="塾長に無料相談する" href={LINE_URL} id="cta-2" />

  {/* ============ §3 2つの学び方（脱カード・レイヤー構成） ============ */}
  <section class="section section--white learn section-anchor" id="services">
    <div class="container">
      <SectionHeader
        title="義塾2つの学び方"
        lead="義塾は、校舎・家庭教師の<span class='num'>2</span>つの学び方を用意しています。<span class='mark'>お子様一人ひとりの状況に合わせて、最適な学び方をご提案できる</span>。"
      />

    </div>

    <article class="service service--real section-anchor" id="service-real" style="--accent:#4C1D95;--accent-deep:#2D1167;">
      <div class="service__hero">
        <img class="service__hero-photo" src={`${base}images/optimized/hero-real.webp`} alt="義塾の校舎・個別指導教室" width="1200" height="1600" loading="lazy" decoding="async" />
        <div class="service__hero-tint" aria-hidden="true"></div>
        <div class="service__hero-content">
          <div class="container">
            <div class="service__hero-top">
              <span class="service__num" aria-hidden="true">01</span>
              <h3 class="service__name">義塾</h3>
            </div>
            <div class="service__hero-bottom">
              <p class="service__eyebrow">通塾型｜個別＋クラス</p>
              <p class="service__catch">質問できる距離で、<br />考える力を育てる。</p>
            </div>
          </div>
        </div>
      </div>

      <div class="service__body">
        <div class="container">
          <div class="service__story">
            <p>「家ではどうしてもやる気が出ない」「親の前では、ついサボってしまう」——保護者の方からよく聞くお声です。</p>
            <p>義塾の校舎は、そんなお子様にとっての <span class="mark">「集中できる場所」</span> になります。9人の講師陣と顔を合わせ、わからないことをその場で質問できる。同じ机に向かう仲間がいる。教室の空気が、お子様の背中をそっと押し続けます。</p>
          </div>

          <details class="service__details">
            <summary>

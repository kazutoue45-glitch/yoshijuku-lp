---
import Base from "../layouts/Base.astro";

const base = import.meta.env.BASE_URL;

// 3サービス（クイックナビ・比較で利用）
const services = [
  {
    num: "01",
    name: "義塾（リアル校舎）",
    tagline: "成田町の校舎で、講師陣と一緒に学ぶ",
    target: "小3〜高3",
    price: "14,300〜44,000円",
    forWhom: [
      "通塾できる距離に住んでいる",
      "同年代と切磋琢磨させたい",
      "クラスと個別を使い分けたい",
    ],
    anchor: "service-real",
    color: "#4C1D95",
    iconKey: "school",
  },
  {
    num: "02",
    name: "義塾オンライン",
    tagline: "完全個別1対1、選べる4つの専門講座をご自宅から",
    target: "小4〜社会人",
    price: "22,000円〜（月4コマ目安）",
    forWhom: [
      "自宅で集中して学ばせたい",
      "英検・TOEIC・探究・AIなど専門領域を伸ばしたい",
      "移動時間をゼロにしたい",
    ],
    anchor: "service-online",
    color: "#2E8B57",
    iconKey: "monitor",
  },
  {
    num: "03",
    name: "義塾の家庭教師",
    tagline: "講師がご自宅へ訪問・塾長と直接つながる",
    target: "中1〜高2",
    price: "26,400円〜(1名)/46,200円〜(ペア)",
    forWhom: [
      "マンツーマンで進路相談まで含めたい",
      "兄弟姉妹・お友達とペア受講したい",
      "塾長と直接つながる安心がほしい",
    ],
    anchor: "service-tutor",
    color: "#2563B8",
    iconKey: "bag",
  },
];

// 共感チェックリスト
const empathyItems = [
  "お子様のテストの点数が伸び悩んでいる",
  "受験までに間に合うか不安",
  "子どもに合う指導形態（個別／クラス／オンライン／家庭教師）が分からない",
  "通塾の送迎が大変",
  "自宅学習だと集中できない",
  "進路や勉強法を相談できる相手が欲しい",
];

// FAQ
const faqs = [
  {
    q: "初月授業料1ヶ月無料の対象や条件を教えてください。",
    a: "新規入塾生限定のキャンペーンです。対象期間・対象サービス・対象学年・適用条件の詳細は、公式LINEからお問い合わせください。",
  },
  {
    q: "無料体験はできますか？",
    a: "はい、公式LINE登録後、塾長との個別相談を経て無料体験授業をご案内します（リアル校舎・オンライン・家庭教師いずれも対応）。",
  },
  {
    q: "途中で退塾する場合の手続きは？",
    a: "月末締めでのご退塾手続きが基本です。違約金等は発生しません。",
  },
  {
    q: "部活や習い事と両立できますか？",
    a: "はい、リアル校舎は17:00〜21:40の中から時間帯を選択でき、家庭教師は曜日・時間をご家庭の都合に合わせて調整します。オンラインなら移動時間ゼロで両立しやすくなります。",
  },
  {
    q: "途中で指導形態（リアル↔オンライン↔家庭教師）を変更できますか？",
    a: "状況に応じて柔軟にご相談いただけます。塾長との個別面談で最適な形をご提案します。",
  },
  {
    q: "受験対策はどの学年から始めればよいですか？",
    a: "中学受験は小3〜小5、高校受験は中1〜中2、大学受験は高1からのスタートが理想です。学年や状況に応じて、塾長が最適なプランをご提案します。",
  },
];
---

<Base>

  {/* ============================================================
      §1 ファーストビュー
      ============================================================ */}
  <section class="hero">
    {/* 上部紫帯：ロゴ＋住所サブ */}
    <div class="hero__band">
      <div class="hero__band-inner">
        <h1 class="hero__brand">
          <ruby>義塾<rt>よしじゅく</rt></ruby>
        </h1>
        <p class="hero__band-meta">
          寝屋川市成田町の学習塾<br />
          <small>小学生・中学生・高校生 対応</small>
        </p>
      </div>
    </div>

    {/* 授業風景写真 */}
    <div class="hero__photo">
      <img src={`${base}images/hero-photo.jpg`} alt="義塾の授業風景：先生が二次関数を解説、生徒が学んでいる" loading="eager" />
    </div>

    {/* 白下段：メインキャッチ＋バッジ */}
    <div class="hero__panel">
      <div class="hero__catch">
        <div class="hero__catch-text">
          <p class="hero__catch-row1">今よりもう一段上の</p>
          <h2 class="hero__catch-row2">賢さを。</h2>
        </div>
        <p class="hero__sub">
          『行きたい高校・大学に合格させたい』<br />
          その想いに、8人の講師陣が本気で応えます。
        </p>
      </div>

      <aside class="badge" aria-label="新規入塾生限定 初月授業料1ヶ月無料">
        <span class="badge__ribbon">新規入塾生限定</span>
        <p class="badge__small">初月授業料</p>
        <p class="badge__main">1ヶ月無料</p>
        <p class="badge__note">※適用条件あり</p>
      </aside>
    </div>

    {/* 3チップ */}
    <ul class="hero__chips" role="list">
      <li>
        <span class="chip__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" width="22" height="22">
            <path d="M3 10l9-5 9 5-9 5-9-5z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>
            <path d="M7 12v5c0 1.2 2.5 2.2 5 2.2s5-1 5-2.2v-5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
            <path d="M21 10v5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
          </svg>
        </span>
        <span class="chip__text">中学受験・高校受験・<br />大学受験すべて対応</span>
      </li>
      <li>
        <span class="chip__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" width="22" height="22">
            <path d="M21 12c0 4.4-4 8-9 8-1.5 0-3-.3-4.3-.8L3 20l1.4-3.6C3.5 15.2 3 13.6 3 12c0-4.4 4-8 9-8s9 3.6 9 8z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>
          </svg>
        </span>
        <span class="chip__text">公式LINEで塾長と<br />直接相談できる</span>
      </li>
      <li>
        <span class="chip__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" width="22" height="22">
            <path d="M12 22s8-7 8-13a8 8 0 1 0-16 0c0 6 8 13 8 13Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>
            <circle cx="12" cy="9" r="2.6" stroke="currentColor" stroke-width="1.6"/>
          </svg>
        </span>
        <span class="chip__text">寝屋川市成田町・<br />成田山不動尊近く</span>
      </li>
    </ul>

    {/* CTA */}
    <a href="#" class="cta cta--fv" aria-label="今だけ初月無料で申し込む">
      <span class="cta__icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" width="20" height="20">
          <path d="M21 12c0 4.4-4 8-9 8-1.5 0-3-.3-4.3-.8L3 20l1.4-3.6C3.5 15.2 3 13.6 3 12c0-4.4 4-8 9-8s9 3.6 9 8z" stroke="currentColor" stroke-width="1.7"/>
          <text x="12" y="14" font-size="6" font-weight="700" fill="currentColor" text-anchor="middle">LINE</text>
        </svg>
      </span>
      <span class="cta__text">今だけ初月無料で申し込む</span>
      <svg class="cta__chev" viewBox="0 0 24 24" fill="none" width="14" height="14" aria-hidden="true">
        <path d="M9 6l6 6-6 6" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </a>

    <p class="hero__scroll">スクロールして詳細を見る
      <svg viewBox="0 0 24 24" width="12" height="12" fill="none" aria-hidden="true">
        <path d="M6 9l6 6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </p>
  </section>


  {/* ============================================================
      §2 サービスクイックナビ
      ============================================================ */}
  <section class="sect sect--white">
    <div class="wrap">
      <p class="eyebrow eyebrow--quiet"><span>学び方を選ぶ</span></p>
      <p class="quicknav__lead">
        学び方は3つ。お子様の状況に合わせて、塾長と一緒に最適な学び方を見つけられます。
      </p>

      <div class="quicknav" id="services">
        {services.map((s) => (
          <a href={`#${s.anchor}`} class="svc" style={`--svc-color:${s.color};`}>
            <span class="svc__bar" aria-hidden="true"></span>
            <header class="svc__head">
              <span class="svc__icon" aria-hidden="true">
                {s.iconKey === "school" && (
                  <svg width="32" height="32" viewBox="0 0 24 24" fill="none">
                    <path d="M3 10l9-5 9 5-9 5-9-5z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
                    <path d="M5 11v6h14v-6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                    <path d="M10 14h4M10 17h4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                  </svg>
                )}
                {s.iconKey === "monitor" && (
                  <svg width="32" height="32" viewBox="0 0 24 24" fill="none">
                    <rect x="3" y="5" width="18" height="12" stroke="currentColor" stroke-width="1.5" rx="1"/>
                    <path d="M9 21h6M12 17v4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                    <circle cx="9" cy="11" r="1.4" fill="currentColor"/>
                    <path d="M11 11h6" stroke="currentColor" stroke-width="1.5"/>
                  </svg>
                )}
                {s.iconKey === "bag" && (
                  <svg width="32" height="32" viewBox="0 0 24 24" fill="none">
                    <rect x="4" y="8" width="16" height="12" stroke="currentColor" stroke-width="1.5" rx="1"/>
                    <path d="M8 8V6a4 4 0 0 1 8 0v2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                    <path d="M9 14h6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                  </svg>
                )}
              </span>
              <h3 class="svc__name">{s.name}</h3>
            </header>
            <p class="svc__tag">{s.tagline}</p>

            <dl class="svc__meta">
              <div>
                <dt>対象学年：</dt>
                <dd>{s.target}</dd>
              </div>
              <div>
                <dt>月額目安：</dt>
                <dd>{s.price}</dd>
              </div>
            </dl>

            <div class="svc__forwhom">
              <p class="svc__forwhom-h">こんな保護者の方に</p>
              <ul>
                {s.forWhom.map((line) => <li>{line}</li>)}
              </ul>
            </div>

            <p class="svc__more">→ 詳しく見る</p>
          </a>
        ))}
      </div>
    </div>
  </section>


  {/* ============================================================
      §3 共感ブロック
      ============================================================ */}
  <section class="sect sect--gray">
    <div class="wrap wrap--narrow">
      <p class="eyebrow"><span>共感</span></p>
      <h2 class="heading heading--center">『うちの子、本当に大丈夫かな。』</h2>
      <p class="heading-sub heading-sub--center">夜にふと、そう思ったことはありませんか。</p>
      <p class="lead lead--center lead--small">ひとつでも当てはまるなら、義塾にご相談ください。</p>

      <ul class="empathy" role="list">
        {empathyItems.map((item) => (
          <li>
            <span class="empathy__check" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="14" height="14" fill="none">
                <path d="M5 12l4 4 10-10" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </span>
            <span class="empathy__text">{item}</span>
          </li>
        ))}
      </ul>

      <a href="#" class="cta" aria-label="公式LINEで、塾長に相談する">
        <span class="cta__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" width="20" height="20">
            <path d="M21 12c0 4.4-4 8-9 8-1.5 0-3-.3-4.3-.8L3 20l1.4-3.6C3.5 15.2 3 13.6 3 12c0-4.4 4-8 9-8s9 3.6 9 8z" stroke="currentColor" stroke-width="1.7"/>
            <text x="12" y="14" font-size="6" font-weight="700" fill="currentColor" text-anchor="middle">LINE</text>
          </svg>
        </span>
        <span class="cta__text">公式LINEで、塾長に相談する</span>
        <svg class="cta__chev" viewBox="0 0 24 24" fill="none" width="14" height="14" aria-hidden="true">
          <path d="M9 6l6 6-6 6" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>
    </div>
  </section>


  {/* ============================================================
      §4 3サービス比較
      ============================================================ */}
  <section class="sect sect--white">
    <div class="wrap">
      <p class="eyebrow"><span>3つの学び方</span></p>
      <h2 class="heading">お子様に合う学び方が、<br />必ずあります。</h2>
      <p class="lead">
        成績が伸びないのは、お子様の能力ではなく、<span class="hl">学び方が合っていないだけ</span>かもしれません。義塾は、リアル校舎・オンライン・家庭教師の3サービスを併走しています。お子様の状況に合わせて選べる、それが義塾の強みです。
      </p>

      {/* リアル校舎 */}
      <article class="cmp section-anchor" id="service-real" style="--svc-color:#4C1D95;">
        <span class="cmp__bar" aria-hidden="true"></span>
        <header class="cmp__head">
          <span class="cmp__num">01</span>
          <h3 class="cmp__name">義塾（リアル校舎）</h3>
        </header>
        <p class="cmp__catch">指導経験が豊富で安心できる8人の講師陣と、集中できる環境</p>
        <div class="cmp__body">
          <div class="cmp__photo">
            <img src={`${base}images/hero-photo.jpg`} alt="義塾の授業風景" loading="lazy" />
          </div>
          <dl class="cmp__data">
            <div><dt>対象</dt><dd>小3〜高3</dd></div>
            <div><dt>指導形態</dt><dd>個別指導（月水木金 17:00〜21:40）／クラス授業</dd></div>
            <div><dt>強み</dt><dd>指導経験豊富な講師陣／個別とクラスを使い分け</dd></div>
            <div><dt>おすすめ</dt><dd>新学期はクラス授業の受講開始期</dd></div>
          </dl>
        </div>
      </article>

      {/* オンライン */}
      <article class="cmp section-anchor" id="service-online" style="--svc-color:#2E8B57;">
        <span class="cmp__bar" aria-hidden="true"></span>
        <header class="cmp__head">
          <span class="cmp__num">02</span>
          <h3 class="cmp__name">義塾オンライン</h3>
        </header>
        <p class="cmp__catch">完全個別指導1対1、選べる4つの専門講座をご自宅から</p>
        <div class="cmp__body">
          <div class="cmp__photo">
            <img src={`${base}images/service-online.svg`} alt="オンライン受講イメージ" loading="lazy" />
          </div>
          <dl class="cmp__data">
            <div><dt>対象</dt><dd>小4〜社会人</dd></div>
            <div><dt>指導形態</dt><dd>完全個別1対1</dd></div>
            <div>
              <dt>4つの講座</dt>
              <dd>探究プレゼン／実践プレゼン／AI音楽制作／英検・TOEIC対策</dd>
            </div>
            <div><dt>強み</dt><dd>マンツーマン伴走／TOEIC990点23回連続満点・英検1級講師</dd></div>
          </dl>
        </div>
      </article>

      {/* 家庭教師 */}
      <article class="cmp section-anchor" id="service-tutor" style="--svc-color:#2563B8;">
        <span class="cmp__bar" aria-hidden="true"></span>
        <header class="cmp__head">
          <span class="cmp__num">03</span>
          <h3 class="cmp__name">義塾の家庭教師</h3>
        </header>
        <p class="cmp__catch">講師がご自宅へ。授業も進路相談も、塾長と直接つながる安心を。</p>
        <div class="cmp__body">
          <div class="cmp__photo">
            <img src={`${base}images/service-tutor.svg`} alt="家庭教師訪問イメージ" loading="lazy" />
          </div>
          <dl class="cmp__data">
            <div><dt>対象</dt><dd>中1〜高2</dd></div>
            <div><dt>指導形態</dt><dd>完全マンツーマン／週1日2時間（月4回）</dd></div>
            <div><dt>強み</dt><dd>第1期生特別価格(2026年限定)／講師訪問／公式LINEで塾長と連絡可／ペア受講</dd></div>
          </dl>
        </div>
      </article>

      <a href="#" class="cta" aria-label="自分に合う学び方を、塾長に相談する">
        <span class="cta__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" width="20" height="20">
            <path d="M21 12c0 4.4-4 8-9 8-1.5 0-3-.3-4.3-.8L3 20l1.4-3.6C3.5 15.2 3 13.6 3 12c0-4.4 4-8 9-8s9 3.6 9 8z" stroke="currentColor" stroke-width="1.7"/>
            <text x="12" y="14" font-size="6" font-weight="700" fill="currentColor" text-anchor="middle">LINE</text>
          </svg>
        </span>
        <span class="cta__text">自分に合う学び方を、塾長に相談する</span>
        <svg class="cta__chev" viewBox="0 0 24 24" fill="none" width="14" height="14" aria-hidden="true">
          <path d="M9 6l6 6-6 6" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>
    </div>
  </section>


  {/* ============================================================
      §5 料金一覧
      ============================================================ */}
  <section class="sect sect--gray-2 section-anchor" id="pricing">
    <div class="wrap wrap--narrow">
      <p class="eyebrow"><span>料金</span></p>
      <h2 class="heading">料金は、すべて明朗にお伝えします。</h2>

      <div class="price">
        <h3 class="price__cap">義塾（リアル校舎）</h3>
        <div class="price__scroll">
          <table class="price__tbl">
            <thead>
              <tr>
                <th>学年</th><th>指導方法</th><th>科目・曜日</th><th>時間</th><th>税込月額</th>
              </tr>
            </thead>
            <tbody>
              <tr><td>小3〜高3</td><td>個別指導</td><td>月水木金・5科目</td><td>17:00〜21:40</td><td class="price__amt">14,300〜25,300円</td></tr>
              <tr><td>中1</td><td>クラス授業</td><td>水：数学／金：英国</td><td>19:05〜20:45</td><td class="price__amt">19,800円</td></tr>
              <tr><td>中3</td><td>クラス授業</td><td>木：数数社／金：英英理</td><td>19:05〜21:40</td><td class="price__amt">33,000円</td></tr>
              <tr><td>高1</td><td>クラス授業</td><td>月：英・数</td><td>19:05〜21:40</td><td class="price__amt">15,400円</td></tr>
              <tr><td>高3</td><td>クラス授業</td><td>月水木：国公立・難関私大対策</td><td>19:05〜21:40</td><td class="price__amt">44,000円</td></tr>
            </tbody>
          </table>
        </div>
        <p class="price__note">※中2・高2クラス料金、入塾金・教材費・季節講習費は教室までお問い合わせください。</p>
      </div>

      <div class="price">
        <h3 class="price__cap">義塾の家庭教師</h3>
        <div class="price__scroll">
          <table class="price__tbl">
            <thead>
              <tr>
                <th>プラン</th><th>対象</th><th>頻度</th><th>税込月額</th><th>備考</th>
              </tr>
            </thead>
            <tbody>
              <tr><td>通常(1名)</td><td>中1〜高2</td><td>週1日2時間（月4回・計8時間）</td><td class="price__amt">26,400円＋講師交通費</td><td>第1期生特別価格(2026年入塾生限定)</td></tr>
              <tr><td>ペア受講</td><td>中1〜高2</td><td>週1日2時間（月4回・計8時間）</td><td class="price__amt">46,200円＋交通費(2名分)</td><td>兄弟姉妹・お友達と</td></tr>
            </tbody>
          </table>
        </div>

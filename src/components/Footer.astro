---
const { base } = Astro.props;
---

<footer class="footer">
  <div class="footer__inner">
    <div class="footer__brand">
      <h2 class="footer__logo">
        <ruby>義塾<rt>よしじゅく</rt></ruby>
      </h2>
      <p class="footer__motto">成田町の信頼できる先生に、お子様の未来を任せる。</p>
      <p class="footer__desc">
        寝屋川市成田町の学習塾。リアル校舎・オンライン・家庭教師の3つの学び方で、中学受験・高校受験・大学受験すべてに対応します。
      </p>
    </div>

    <div class="footer__col">
      <h3 class="footer__h">サイトマップ</h3>
      <ul class="footer__list">
        <li><a href="#services">3つの学び方</a></li>
        <li><a href="#pricing">料金</a></li>
        <li><a href="#faq">よくあるご質問</a></li>
        <li><a href="#teachers">講師紹介</a></li>
        <li><a href="#access">アクセス・お問い合わせ</a></li>
      </ul>
    </div>

    <div class="footer__col">
      <h3 class="footer__h">運営会社</h3>
      <p class="footer__entity">義塾／運営：小川探究</p>
      <a href="tel:0728147633" class="footer__tel">072-814-7633</a>
      <p class="footer__addr">大阪府寝屋川市成田町32-24</p>
      <!-- 要確認: 代表者名・正式法人名 -->
    </div>

    <div class="footer__col">
      <h3 class="footer__h">規約・お問い合わせ</h3>
      <ul class="footer__list">
        <li><a href="#">利用規約</a></li>
        <li><a href="#">プライバシーポリシー</a></li>
        <li><a href="#">公式LINE</a></li>
        <!-- 要確認: 規約・プラポリの公開URL／公式LINE URL -->
      </ul>
    </div>
  </div>

  <p class="footer__copy">© 2026 義塾 / 小川探究 All Rights Reserved.</p>
</footer>

<style>
  .footer {
    background: var(--purple-deep);
    color: var(--paper);
    padding: 56px 0 28px;
    position: relative;
  }

  .footer::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: var(--orange);
    opacity: 0.55;
  }

  .footer__inner {
    max-width: 720px;
    margin: 0 auto;
    padding: 0 28px;
  }

  /* ============== ブランドエリア ============== */
  .footer__brand {
    margin-bottom: 36px;
  }

  .footer__logo {
    font-family: var(--font-serif);
    font-size: 56px;
    font-weight: 700;
    line-height: 1;
    letter-spacing: 0.04em;
    color: var(--paper);
    margin-bottom: 18px;
  }

  .footer__logo ruby rt {
    font-size: 13px;
    font-weight: 400;
    letter-spacing: 0.18em;
    color: rgba(255, 255, 255, 0.78);
    font-family: var(--font-sans);
    margin-bottom: 6px;
  }

  .footer__motto {
    font-size: 16px;
    font-weight: 700;
    color: var(--paper);
    line-height: 1.65;
    margin-bottom: 14px;
    letter-spacing: 0.02em;
  }

  .footer__desc {
    font-size: 13px;
    line-height: 1.95;
    color: rgba(255, 255, 255, 0.62);
    letter-spacing: 0.02em;
  }

  /* ============== 各列 ============== */
  .footer__col {
    margin-bottom: 32px;
  }

  .footer__h {
    font-size: 13px;
    font-weight: 700;
    color: var(--orange);
    letter-spacing: 0.18em;
    margin-bottom: 16px;
    font-family: var(--font-sans);
  }

  .footer__list {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .footer__list a {
    font-size: 14px;
    color: rgba(255, 255, 255, 0.86);
    transition: color 0.2s;
  }

  .footer__list a:hover {
    color: var(--orange);
  }

  .footer__entity {
    font-size: 14px;
    color: rgba(255, 255, 255, 0.86);
    margin-bottom: 6px;
  }

  .footer__tel {
    display: inline-block;
    font-family: var(--font-serif);
    font-size: 32px;
    font-weight: 600;
    color: var(--paper);
    letter-spacing: 0.04em;
    line-height: 1.1;
    margin-bottom: 6px;
  }

  .footer__tel:hover {
    color: var(--orange);
  }

  .footer__addr {
    font-size: 12px;
    color: rgba(255, 255, 255, 0.6);
    letter-spacing: 0.02em;
  }

  /* ============== コピーライト ============== */
  .footer__copy {
    margin-top: 40px;
    padding: 0 28px;
    font-size: 11px;
    color: rgba(255, 255, 255, 0.4);
    text-align: center;
    letter-spacing: 0.04em;
  }

  /* ============== PC ============== */
  @media (min-width: 769px) {
    .footer__inner {
      max-width: 1080px;
      display: grid;
      grid-template-columns: 1.4fr 1fr 1fr 1fr;
      gap: 48px;
    }
    .footer__brand {
      margin-bottom: 0;
    }
    .footer__col {
      margin-bottom: 0;
    }
    .footer__logo {
      font-size: 64px;
    }
  }
</style>

---
import Footer from "../components/Footer.astro";
import Analytics from "../components/Analytics.astro";
import "../styles/global.css";

const { title, description, image = "/images/og-yoshijuku.jpg" } = Astro.props;
const pageTitle = title
  ? `${title}｜義塾（成田町）`
  : "義塾｜成田町の学習塾｜中学受験・高校受験・大学受験／個別指導・クラス授業・家庭教師・プレゼン講座";
const pageDesc =
  description ??
  "成田町の学習塾「義塾」。校舎・家庭教師の2つの学び方から選べる地域密着型の塾。プレゼン講座はオプションで受講できます。新規入塾生限定で初月授業料1ヶ月無料キャンペーン実施中。公式LINEで塾長と直接相談できます。";
const base = import.meta.env.BASE_URL;
const siteOrigin = "https://yoshijuku.vercel.app";
const canonicalUrl = new URL(Astro.url.pathname, siteOrigin).toString();
const ogImageUrl = new URL(image, siteOrigin).toString();
---

<!DOCTYPE html>
<html lang="ja">
  <head>
    <Analytics />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDesc} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDesc} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ja_JP" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="成田町の学習塾 義塾" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDesc} />
    <meta name="twitter:image" content={ogImageUrl} />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="theme-color" content="#4C1D95" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="apple-touch-icon" href={`${base}favicon.svg`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500;700;900&family=Noto+Serif+JP:wght@500;700&family=DM+Serif+Display:ital@0;1&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <a class="skip-link" href="#main-content">本文へ移動</a>
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    <Footer base={base} />
  </body>
</html>
